# sm2-emu — the build's version, as `git describe --tags --exclude dev` names it
# (v0.9.54-59-g9c0c080, the release packages' name), for the window's title.
#
# Run as a script at every build (cmake -P), so that a new commit shows
# without configuring again; the header is rewritten only when the version
# changes, so nothing is rebuilt for nothing. Without git, or outside a
# repository, the project's version.
#
# Inputs: SM2_GIT (git's path, may be empty), SM2_SOURCE_DIR, SM2_FALLBACK
# (the project's version), SM2_OUT (the header to write).

set(version "")
if(SM2_GIT)
    # Not upstream's "dev" tag: it moves to its latest main, so once merged it
    # would be the nearest tag and name every build dev-N-g....
    execute_process(
        COMMAND "${SM2_GIT}" describe --tags --exclude dev
        WORKING_DIRECTORY "${SM2_SOURCE_DIR}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE version
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(NOT result EQUAL 0)
        set(version "")
    endif()
endif()
if(version STREQUAL "")
    set(version "v${SM2_FALLBACK}")
endif()

set(text "// Generated by cmake/BuildVersion.cmake at each build.\n#pragma once\n#define SM2_BUILD_VERSION \"${version}\"\n")
set(old "")
if(EXISTS "${SM2_OUT}")
    file(READ "${SM2_OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${SM2_OUT}" "${text}")
endif()
